\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The reconstructed encoding circuit for $G^\top $'s column-linear entries.} A ripple-carry adder shifts the $n$-qubit column-index register into the form the ladder consumes, and is uncomputed afterwards. A ladder of $n$ singly-controlled $R_y(\theta _m)$ rotations accumulates the amplitude $\mathrm  {raw}(p)$ of \Cref  {eq:app-ladder-raw} on one flag qubit by exact angle addition; a second, independently controlled ladder applies the row-zero correction. Ancilla: $n+4$ total (\Cref  {app:pihm-circuit}).}}{9}{figure.caption.20}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pihm-ladder-circuit}{{1}{9}{\textbf {The reconstructed encoding circuit for $G^\top $'s column-linear entries.} A ripple-carry adder shifts the $n$-qubit column-index register into the form the ladder consumes, and is uncomputed afterwards. A ladder of $n$ singly-controlled $R_y(\theta _m)$ rotations accumulates the amplitude $\mathrm {raw}(p)$ of \Cref {eq:app-ladder-raw} on one flag qubit by exact angle addition; a second, independently controlled ladder applies the row-zero correction. Ancilla: $n+4$ total (\Cref {app:pihm-circuit})}{figure.caption.20}{}}
\newlabel{fig:pihm-ladder-circuit@cref}{{[figure][1][]1}{[1][8][]9}{}{}{}}
