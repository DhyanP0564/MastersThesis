\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The odd-offset shifts are one subtraction.} PREPARE (left) puts the offset register $d$ in a uniform superposition over the $N/2$ odd offsets, by an $X$ on its lowest qubit and Hadamards on the rest. SELECT is a ripple-carry subtractor \blx@tocontentsinit {0}\cite {cuccaro2004adder} that replaces the system register $p$ by $p-d$ and sets the borrow flag when $p<d$. PREPARE$^\dagger $ (right) with post-selection of $d$ and the borrow flag on $\mathinner {|{0}\rangle }$ keeps $\tfrac  {2}{N}\mathinner {|{k}\rangle }\!\mathinner {\langle {p}|}$ for every odd $d=p-k\ge 1$, and the wrapped terms vanish exactly. The block is $U_{\mathrm  {odd}}/(N/2)$, so $\alpha =N/2$, on $n$ system and $n+2$ ancilla qubits.}}{17}{figure.caption.29}\protected@file@percent }
\newlabel{fig:uodd-select}{{1}{17}{\textbf {The odd-offset shifts are one subtraction.} PREPARE (left) puts the offset register $d$ in a uniform superposition over the $N/2$ odd offsets, by an $X$ on its lowest qubit and Hadamards on the rest. SELECT is a ripple-carry subtractor \cite {cuccaro2004adder} that replaces the system register $p$ by $p-d$ and sets the borrow flag when $p<d$. PREPARE$^\dagger $ (right) with post-selection of $d$ and the borrow flag on $\ket {0}$ keeps $\tfrac {2}{N}\ket {k}\!\bra {p}$ for every odd $d=p-k\ge 1$, and the wrapped terms vanish exactly. The block is $\Uodd /(N/2)$, so $\alpha =N/2$, on $n$ system and $n+2$ ancilla qubits}{figure.caption.29}{}}
\newlabel{fig:uodd-select@cref}{{[figure][1][]1}{[1][17][]17}{}{}{}}
\newlabel{prop:standard-cost}{{2}{17}{Cost of the structured encoding}{proposition.2}{}}
\newlabel{prop:standard-cost@cref}{{[proposition][2][]2}{[1][17][]17}{}{}{}}
\newlabel{eq:standard-cost}{{4.3}{17}{Cost of the structured encoding}{equation.4.3}{}}
\newlabel{eq:standard-cost@cref}{{[equation][3][4]4.3}{[1][17][]17}{}{}{}}
