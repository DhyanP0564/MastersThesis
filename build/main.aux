\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Measured subnormalisation and spectral-gap collapse of the composed $H$, $n=2$ to $8$.} (a) $\alpha _H$ against $N=2^n$ on log-log axes, empirically $\Theta (N^8)$, against $\|H\|=\Theta (N^2)$. (b) Relative spectral gap of the composed $H$ against $n$, falling to $\sim 10^{-15}$ by $n\gtrsim 7$, below double-precision machine epsilon (dashed line).}}{10}{figure.caption.21}\protected@file@percent }
\newlabel{fig:pihm-gap-collapse}{{2}{10}{\textbf {Measured subnormalisation and spectral-gap collapse of the composed $H$, $n=2$ to $8$.} (a) $\alpha _H$ against $N=2^n$ on log-log axes, empirically $\Theta (N^8)$, against $\|H\|=\Theta (N^2)$. (b) Relative spectral gap of the composed $H$ against $n$, falling to $\sim 10^{-15}$ by $n\gtrsim 7$, below double-precision machine epsilon (dashed line)}{figure.caption.21}{}}
