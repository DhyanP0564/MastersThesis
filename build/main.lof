\contentsline {figure}{\numberline {7}{\ignorespaces Every encoding is verified to its mode's tolerance at every size tested.}}{39}{figure.caption.65}%
\contentsline {figure}{\numberline {8}{\ignorespaces The prepared state reproduces the analytic solution to within the predicted error budget.}}{39}{figure.caption.66}%
\contentsline {figure}{\numberline {9}{\ignorespaces The encoder wall and the Hamiltonian wall are separate gaps.}}{40}{figure.caption.68}%
